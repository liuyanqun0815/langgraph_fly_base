# ========== 应用 ==========
APP_SECRET_KEY=replace-me-for-session-csrf
DATABASE_URL=sqlite:///./db.sqlite3
SERVICE_API_URL=http://127.0.0.1:8000
USER_INFO_MASK=False

# ========== LLM（DashScope OpenAI 兼容模式，优先于 ZHIPU_*）==========
LLM_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
# 是否开启 LLM 推理/思考（DashScope enable_thinking；分类等简单任务建议 false）
LLM_ENABLE_REASONING=false
# 问题分类 few-shot 示例数：0=关闭（最快），1=一条示例（推荐），2=两条示例
QUESTION_CLASS_FEW_SHOT=1
# 问题分类带入的历史对话轮数（越大越慢，4~6 通常足够）
QUESTION_CLASS_HISTORY_TURNS=4

# Embedding（知识库稠密向量，需与 Milvus collection dim 一致）
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# 知识库文档分块（字符数，Word/PDF/Excel 通用上传时生效）
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120

# 客户转化 / 客服联系方式
CUSTOMER_SERVICE_PHONE=400-888-0000
CUSTOMER_SERVICE_HOURS=工作日 9:00-18:00
OFFLINE_BRANCH_HINT=请携带身份证及相关材料前往就近网点办理，或通过人工客服预约客户经理上门服务

# ========== 智谱（LLM_* 未配置时回退）==========
ZHIPU_API_KEY=
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-4
ZHIPU_TEMPERATURE=0.1

# ========== 向量数据库：Milvus（当前唯一启用后端）==========
VECTOR_TYPE=milvus
# Milvus 端口（Docker Compose 内 app 服务请改为 MILVUS_HOST=milvus）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=default
# MILVUS_PASSWORD=

# 知识库默认集合（上传/检索未指定时使用）
DEFAULT_KB_COLLECTION=loan_qa
# 产品推荐集合
RECOMMEND_COLLECTION_NAME=recommend_product
RECOMMEND_TOP_K=5

# ========== LangSmith（默认关闭）==========
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
